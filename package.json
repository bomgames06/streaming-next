{
  "name": "streaming-next",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run check && wxt build",
    "build:firefox": "bun run check && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test:run": "vitest --run",
    "test:dev": "vitest",
    "test:ui": "vitest --ui",
    "check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:staged": "lint-staged",
    "preinstall": "bunx only-allow bun",
    "postinstall": "wxt prepare && bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check && bun run lint:staged && bun run test:run"
  },
  "lint-staged": {
    "**/*.{mjs,js,mts,ts,vue}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "core-js": "^3.51.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "moment": "^2.31.0",
    "moment-duration-format": "^2.3.2",
    "mousetrap": "^1.6.5",
    "pinia": "^4.1.0",
    "roboto-fontface": "^0.10.0",
    "toastr": "^2.1.4",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@pinia/testing": "^2.0.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/lodash": "^4.17.27",
    "@types/moment-duration-format": "^2.2.7",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^26.6.5",
    "@types/toastr": "^2.1.44",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.106.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vitest-chrome": "^0.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.21.4"
  }
}
