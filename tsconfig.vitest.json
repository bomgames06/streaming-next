{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": [
      "vitest/jsdom",
      "vitest/importMeta",
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tests/*": [
        "./tests/*"
      ]
    },
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src/**/*.d.ts",
    "src/auto-imports.d.ts",
    "src/components.d.ts",
    "tests/**/*",
    "vitest.setup.ts"
  ],
  "exclude": ["dist", "node_modules"],
}
